@model int
<div class="d-flex flex-column vehicleTabPane" style="height:100%;">
    <input type="hidden" id="timelineVehicleId" value="@Model" />

    <!-- Top Controls Row -->
    <div class="d-flex align-items-center gap-2 mb-1">
        <div class="dropdown">
            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" id="metricsDropdown" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                <i class="bi bi-sliders me-1"></i>Metrics
            </button>
            <div class="dropdown-menu p-2" style="width:200px; max-height:300px; overflow-y:auto;">
                <div class="d-flex gap-1 mb-1">
                    <button class="btn btn-sm btn-link p-0" onclick="selectAllTimelineFields()">All</button>
                    <button class="btn btn-sm btn-link p-0" onclick="selectNoTimelineFields()">None</button>
                </div>
                <div id="timelineFieldsContainer">
                    <small class="text-muted">Loading...</small>
                </div>
            </div>
        </div>
        <button onclick="renderTimeline()" class="btn btn-sm btn-primary">
            <i class="bi bi-graph-up me-1"></i>Render
        </button>
        <span id="timelinePointCount" class="badge bg-secondary"></span>
        <small class="text-muted ms-auto">Scroll to zoom | Shift+scroll to pan | Double-click axis to edit | Double-click chart to reset</small>
    </div>

    <!-- Chart Canvas (full width) -->
    <div class="flex-grow-1 position-relative" style="min-height:500px;">
        <canvas id="timelineChart"></canvas>

        <!-- Axis Config Popup -->
        <div id="axisConfigPopup" class="card shadow position-absolute" style="display:none; z-index:1050; width:220px;">
            <div class="card-body p-2">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <strong id="axisConfigTitle" class="small">Edit: speed</strong>
                    <button type="button" class="btn-close" style="font-size:0.6rem;" onclick="$('#axisConfigPopup').hide()"></button>
                </div>
                <div class="row g-1 mb-2">
                    <div class="col-6">
                        <label class="form-label mb-0 small">Min</label>
                        <input type="number" id="axisMin" class="form-control form-control-sm" step="any">
                    </div>
                    <div class="col-6">
                        <label class="form-label mb-0 small">Max</label>
                        <input type="number" id="axisMax" class="form-control form-control-sm" step="any">
                    </div>
                </div>
                <div class="mb-2">
                    <label class="form-label mb-0 small">Color</label>
                    <div class="d-flex flex-wrap gap-1 align-items-center">
                        <span class="axis-color-swatch" style="background:#FF6384;" data-color="#FF6384"></span>
                        <span class="axis-color-swatch" style="background:#36A2EB;" data-color="#36A2EB"></span>
                        <span class="axis-color-swatch" style="background:#FFCE56;" data-color="#FFCE56"></span>
                        <span class="axis-color-swatch" style="background:#4BC0C0;" data-color="#4BC0C0"></span>
                        <span class="axis-color-swatch" style="background:#9966FF;" data-color="#9966FF"></span>
                        <span class="axis-color-swatch" style="background:#FF9F40;" data-color="#FF9F40"></span>
                        <span class="axis-color-swatch" style="background:#66BB6A;" data-color="#66BB6A"></span>
                        <span class="axis-color-swatch" style="background:#EF5350;" data-color="#EF5350"></span>
                        <input type="color" id="axisCustomColor" class="form-control form-control-color p-0" style="width:22px;height:22px;border:none;" title="Custom color">
                    </div>
                </div>
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="axisZeroLine">
                    <label class="form-check-label small" for="axisZeroLine">Show zero line</label>
                </div>
                <div class="d-flex gap-1">
                    <button class="btn btn-sm btn-primary flex-grow-1" onclick="applyAxisConfig()">Apply</button>
                    <button class="btn btn-sm btn-outline-secondary" onclick="resetAxisConfig()">Auto</button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .axis-color-swatch {
        display: inline-block;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        cursor: pointer;
        border: 2px solid transparent;
    }
    .axis-color-swatch:hover, .axis-color-swatch.selected {
        border-color: #333;
    }
</style>
