@using CarCareTracker.Models.LoggerSync
@model TrackerHealthViewModel
<div class="d-flex flex-column vehicleTabPane">

    <!-- Health Cards -->
    <div class="row g-3 mb-4 mt-2">
        <div class="col">
            <div class="card text-center">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Battery</h6>
                    <h4 class="card-title">@(Model.LatestBatteryVoltage.HasValue ? $"{Model.LatestBatteryVoltage.Value:F2}V" : "—")</h4>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card text-center">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Satellites</h6>
                    <h4 class="card-title">@(Model.LatestSatCount.HasValue ? Model.LatestSatCount.Value.ToString() : "—")</h4>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card text-center">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">SD Card</h6>
                    @if (Model.SdTotalMb.HasValue && Model.SdFreeMb.HasValue && Model.SdTotalMb.Value > 0)
                    {
                        var usedMb = Model.SdTotalMb.Value - Model.SdFreeMb.Value;
                        var pctUsed = (int)Math.Round(100.0 * usedMb / Model.SdTotalMb.Value);
                        <h3 class="card-title mb-1">@(pctUsed)% used</h3>
                        <small class="text-muted">@($"{usedMb:N0}") / @($"{Model.SdTotalMb.Value:N0}") MB</small>
                    }
                    else
                    {
                        <h4 class="card-title">—</h4>
                    }
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card text-center">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Last Sync</h6>
                    <h5 class="card-title">@Model.LastSyncTime</h5>
                    <small class="text-muted">@Model.LastSyncFile</small>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card text-center">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Firmware</h6>
                    <div><small class="text-muted">Running:</small> <span class="badge bg-secondary">@Model.RunningFirmwareVersion</span></div>
                    <div><small class="text-muted">Uploaded:</small> <span class="badge bg-primary">@Model.CurrentFirmwareVersion</span></div>
                    @if (Model.RunningFirmwareVersion != "—" && Model.RunningFirmwareVersion != Model.CurrentFirmwareVersion)
                    {
                        <span class="badge bg-warning text-dark mt-1">Update pending</span>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="vehicleDetailTabContainer flex-grow-1">
        <!-- Manual Data Upload -->
        <div class="card mb-4">
            <div class="card-body">
                <h6 class="card-title"><i class="bi bi-folder-symlink me-1"></i>Manual Data Upload</h6>
                <p class="small text-muted mb-2">
                    Pick your SD card folder to upload data that didn't sync over WiFi.
                    Files already received are skipped automatically.
                </p>
                <div class="row g-2 align-items-end">
                    <div class="col-auto">
                        <label class="form-label mb-0 small">SD Card Folder</label>
                        <input type="file" id="csvFolder" class="form-control form-control-sm" multiple webkitdirectory directory />
                    </div>
                    <div class="col-auto">
                        <button onclick="uploadTelemetryFiles()" class="btn btn-sm btn-success" id="csvUploadBtn">
                            <i class="bi bi-cloud-upload me-1"></i>Upload
                        </button>
                    </div>
                </div>
                <div id="csvUploadStatus" class="small text-muted mt-2"></div>
            </div>
        </div>
        
        <!-- Upload Firmware -->
        <div class="card mb-4">
            <div class="card-body">
                <h6 class="card-title"><i class="bi bi-upload me-1"></i>Upload New Firmware</h6>
                <div class="row g-2 align-items-end">
                    <div class="col">
                        <label class="form-label mb-0 small">Notes</label>
                        <input type="text" id="fwNotes" class="form-control form-control-sm" placeholder="What changed?" />
                    </div>
                    <div class="col-auto">
                        <label class="form-label mb-0 small">.bin File</label>
                        <input type="file" id="fwFile" class="form-control form-control-sm" accept=".bin" />
                    </div>
                    <div class="col-auto">
                        <button onclick="uploadFirmware()" class="btn btn-sm btn-success" id="fwUploadBtn">
                            <i class="bi bi-cloud-upload me-1"></i>Upload
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Firmware History -->
        <h6><i class="bi bi-cpu me-1"></i>Firmware History</h6>

        @if (Model.FirmwareHistory.Any())
        {
            <div class="table-responsive mb-4">
                <table class="table table-sm table-hover">
                    <thead>
                        <tr>
                            <th>Version</th>
                            <th>Uploaded</th>
                            <th>Size</th>
                            <th>Notes</th>
                            <th>Active</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fw in Model.FirmwareHistory.OrderByDescending(f => f.UploadedAt))
                        {
                            <tr>
                                <td><span class="badge bg-secondary">@fw.Version</span></td>
                                <td>@fw.UploadedAt.ToString("g")</td>
                                <td>@((fw.FileSize / 1024.0).ToString("F0")) KB</td>
                                <td>@fw.Notes</td>
                                <td>@(fw.IsActive ? "✓" : "")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info mb-4">No firmware records found.</div>
        }

        <!-- Recent Files -->
        <h6><i class="bi bi-file-earmark-arrow-up me-1"></i>Recent Synced Files (@Model.ReceivedFiles.Count)</h6>
        @if (Model.ReceivedFiles.Any())
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover">
                    <thead>
                        <tr>
                            <th>Filename</th>
                            <th>Received</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var file in Model.ReceivedFiles)
                        {
                            <tr>
                                <td><code>@file.Filename</code></td>
                                <td>@file.ReceivedAt.ToString("g")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">No synced files recorded.</div>
        }
    </div>
</div>

